            "body": { "mode": "raw", "raw": "{\n  \"customer\": \"{{customerId}}\",\n  \"invoice\": \"{{invoiceId}}\",\n  \"payment_recipient\": \"{{paymentRecipientId}}\",\n  \"currency\": \"EUR\",\n  \"amount\": 12000,\n  \"flow_type\": \"charge\",\n  \"status\": \"succeeded\"\n}" },
            "url": { "raw": "{{baseUrl}}/transactions", "host": ["{{baseUrl}}"], "path": ["transactions"] }
          }
        }
      ]
    },
