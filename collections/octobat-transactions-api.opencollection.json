{
  "opencollection": "1.0.0",
  "info": {
    "name": "Octobat Coupons Transactions API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transactions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apiv2.octobat.com/transactions",
            "params": [
              {
                "name": "customer",
                "value": "",
                "type": "query"
              },
              {
                "name": "invoice",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List transactions"
        },
        {
          "info": {
            "name": "Register a transaction",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apiv2.octobat.com/transactions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Registers a successful payment so Octobat can reconcile it with an invoice and drive tax reporting. (Confirmed in Octobat docs.)"
        },
        {
          "info": {
            "name": "Retrieve a transaction",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apiv2.octobat.com/transactions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a transaction"
        },
        {
          "info": {
            "name": "Update a transaction",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://apiv2.octobat.com/transactions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a transaction"
        },
        {
          "info": {
            "name": "Export transactions to CSV",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apiv2.octobat.com/transactions/csv_export"
          },
          "docs": "Export transactions to CSV"
        }
      ]
    }
  ],
  "bundled": true
}